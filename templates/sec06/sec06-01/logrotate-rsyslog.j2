/var/log/auth.log
/var/log/cron.log
/var/log/daemon.log
/var/log/kern.log
/var/log/lpr.log
/var/log/mail.log
/var/log/syslog
/var/log/user.log
/var/log/mail.warn
/var/log/mail.err
{
	rotate 7
	daily
	dateext
	dateformat -%Y-%m-%d
	missingok
	notifempty
	compress
	delaycompress
	sharedscripts
	postrotate
		/usr/lib/rsyslog/rsyslog-rotate
	endscript
}
