#
# This file controls the configuration of the audit daemon
#

local_events = yes
write_logs = yes
log_file = /var/log/audit/audit.log
log_group = adm
log_format = ENRICHED
flush = INCREMENTAL_ASYNC
freq = 50
max_log_file = {{ hardening_auditd_maxlogfile | int | default(25) }}
num_logs = 5
priority_boost = 4
name_format = NONE
##name = mydomain
max_log_file_action = {{ hardening_auditd_maxlogfileaction | default('keep_logs') }}
space_left = {{ hardening_auditd_spaceleft | default(75) }}
space_left_action = {{ hardening_auditd_spaceleftaction | default('syslog') }}
verify_email = yes
action_mail_acct = root
admin_space_left = {{ hardening_auditd_adminspaceleft | default(50) }}
admin_space_left_action = {{ hardening_auditd_adminspaceleftaction | default('single') }}
disk_full_action = {{ hardening_auditd_diskfullaction | default('single') }}
disk_error_action = {{ hardening_auditd_diskerroraction | default('single') }}
use_libwrap = yes
##tcp_listen_port = 60
tcp_listen_queue = 5
tcp_max_per_addr = 1
##tcp_client_ports = 1024-65535
tcp_client_max_idle = 0
transport = TCP
krb5_principal = auditd
##krb5_key_file = /etc/audit/audit.key
distribute_network = no
q_depth = 2000
overflow_action = SYSLOG
max_restarts = 10
plugin_dir = /etc/audit/plugins.d
end_of_event_timeout = 2
